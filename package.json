{
  "name": "kehikko-history",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Version control for the two histories a project actually has: its own repository, and the .kehikot folder the modules keep their data in. One repo for the whole folder, one process committing, commits written automatically a few seconds after a burst of edits with a message that says what changed.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "register": "bun register.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "roadmap-module-protocol": "git+ssh://git@github.com/Jalez/kehikko-protocol.git#main",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.2.4"
  }
}
